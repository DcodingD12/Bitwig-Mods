{
  "manifest_version": 2,
  "mod": {
    "id": "pinned-tracks",
    "name": "Arranger: Pinned Tracks",
    "area": "Arranger",
    "version": "0.1.0-dev.5",
    "author": "Silent Orbit",
    "description": "Keeps pinned tracks fixed at the top while the others scroll. Right-click > Pin to Top.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "macos",
    "architecture": "universal"
  },
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  },
  "requires": [],
  "registrations": [
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ]
}
