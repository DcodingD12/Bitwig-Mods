  "mod": {
    "id": "timeline-wheel-zoom",
    "name": "Arranger: Timeline Wheel Zoom",
    "area": "Arranger",
    "version": "0.3.1-dev.1",
    "author": "Silent Orbit",
    "description": "Mouse wheel over the timeline ruler zooms smoothly at the pointer (arranger and editor).",
    "documentation": "readme"
