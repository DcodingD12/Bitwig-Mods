{
  "manifest_version": 2,
  "mod": {
    "id": "track-spacer",
    "name": "Arranger: Track Spacer",
    "area": "Arranger",
    "version": "0.2.7-dev.1",
    "author": "Silent Orbit",
    "description": "Adds gaps above or below arranger tracks, without extra tracks. Right-click a track.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "macos",
    "architecture": "universal"
  },
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  },
  "requires": [],
  "registrations": [
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ]
}
