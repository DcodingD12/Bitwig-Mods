{
  "manifest_version": 2,
  "mod": {
    "id": "zoom-toggle",
    "name": "Arranger: Zoom Toggle",
    "area": "Arranger",
    "version": "0.3.2-dev.1",
    "author": "Silent Orbit",
    "description": "One shortcut zooms to the selected clip and makes its track tall. Press again to go back.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "macos",
    "architecture": "universal"
  },
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  },
  "requires": [],
  "registrations": [
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ]
}
